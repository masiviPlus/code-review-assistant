# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:changeme@localhost:27017/code-review-assistant?authSource=admin

# Logging
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# LLM — provider: 'claude' | 'gemini' | 'fake'
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
